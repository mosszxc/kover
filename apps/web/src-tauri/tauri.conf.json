{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Kover",
  "version": "0.1.0",
  "identifier": "com.kover.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "title": "Kover — Управление маршрутами",
    "windows": [
      {
        "label": "main",
        "title": "Kover — Управление маршрутами",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png",
      "tooltip": "Kover — Управление маршрутами",
      "showMenuOnLeftClick": false
    }
  },
  "plugins": {
    "notification": {
      "registerActionTypes": []
    },
    "autostart": {
      "macosExtraArgs": [],
      "windowsExtraArgs": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2025 Kover",
    "shortDescription": "Система управления маршрутами",
    "longDescription": "Kover — система управления маршрутами доставки ковров. Планирование, диспетчеризация, печать маршрутных листов.",
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "startMenuFolder": "Kover"
      }
    }
  }
}
