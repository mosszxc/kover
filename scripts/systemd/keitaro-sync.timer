[Unit]
Description=Daily Keitaro Campaign Sync
Requires=keitaro-sync.service

[Timer]
# Run daily at 00:00 UTC
OnCalendar=*-*-* 00:00:00
# Run immediately if missed (e.g., system was off)
Persistent=true
# Randomize start time by up to 5 minutes to avoid thundering herd
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
