#!/bin/bash
#
# Keitaro Campaign Sync - Daily Cron Script
#
# This script triggers a Keitaro campaign sync via the API.
# It should be run daily to fetch new campaigns for analysis.
#
# Usage:
#   ./scripts/keitaro-sync                    # Default: TU buyer, 1 day
#   ./scripts/keitaro-sync --buyer MK         # Different buyer
#   ./scripts/keitaro-sync --days 7           # Last 7 days
#   ./scripts/keitaro-sync --buyer MK --days 7
#
# Cron setup (daily at 00:00 UTC):
#   0 0 * * * /path/to/Rubick/scripts/keitaro-sync >> /var/log/keitaro-sync.log 2>&1
#
# Or use systemd timer for better logging and reliability.

set -e

# Default values
API_URL="${RUBICK_API_URL:-http://localhost:10000}"
BUYER_SUB_ID="TU"
DAYS_BACK=1

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --buyer)
            BUYER_SUB_ID="$2"
            shift 2
            ;;
        --days)
            DAYS_BACK="$2"
            shift 2
            ;;
        --api-url)
            API_URL="$2"
            shift 2
            ;;
        --help)
            echo "Usage: $0 [--buyer BUYER_ID] [--days DAYS_BACK] [--api-url URL]"
            echo ""
            echo "Options:"
            echo "  --buyer     Buyer sub_id (default: TU)"
            echo "  --days      Days to look back (default: 1)"
            echo "  --api-url   API URL (default: http://localhost:10000)"
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            exit 1
            ;;
    esac
done

echo "[$(date -Iseconds)] Starting Keitaro sync: buyer=${BUYER_SUB_ID}, days_back=${DAYS_BACK}"

# Call the scheduled-sync endpoint (uses Temporal workflow)
RESPONSE=$(curl -s -X POST "${API_URL}/api/keitaro/scheduled-sync" \
    -H "Content-Type: application/json" \
    -d "{\"buyer_sub_id\": \"${BUYER_SUB_ID}\", \"days_back\": ${DAYS_BACK}}")

# Check if request was successful
if echo "$RESPONSE" | grep -q '"status"'; then
    SYNC_ID=$(echo "$RESPONSE" | grep -o '"sync_id":"[^"]*"' | cut -d'"' -f4)
    WORKFLOW_ID=$(echo "$RESPONSE" | grep -o '"workflow_id":"[^"]*"' | cut -d'"' -f4)
    STATUS=$(echo "$RESPONSE" | grep -o '"status":"[^"]*"' | cut -d'"' -f4)

    echo "[$(date -Iseconds)] Sync triggered successfully"
    echo "  sync_id: ${SYNC_ID}"
    echo "  workflow_id: ${WORKFLOW_ID}"
    echo "  status: ${STATUS}"
else
    echo "[$(date -Iseconds)] ERROR: Sync failed"
    echo "$RESPONSE"
    exit 1
fi
